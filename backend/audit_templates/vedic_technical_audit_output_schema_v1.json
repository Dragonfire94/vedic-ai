{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedic-ai.local/schemas/vedic_technical_audit_output_schema_v1.json",
  "title": "Vedic Technical Audit Output V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "availability",
    "technical_findings",
    "commercial_contradictions",
    "commercial_minimal_edits",
    "notes_for_engineers"
  ],
  "properties": {
    "verdict": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "technical_ok",
        "commercial_consistent_with_technical",
        "confidence",
        "blocking_issues_count"
      ],
      "properties": {
        "technical_ok": { "type": "boolean" },
        "commercial_consistent_with_technical": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "blocking_issues_count": { "type": "integer", "minimum": 0 }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ok", "reason", "missing_fields", "audit_limitations"],
      "properties": {
        "ok": { "type": "boolean" },
        "reason": {
          "type": ["string", "null"],
          "enum": [
            "missing_chart_context",
            "missing_varga",
            "missing_dasha",
            "missing_transits",
            "partial_data",
            "unknown",
            null
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audit_limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "technical_findings": {
      "type": "object",
      "additionalProperties": true,
      "required": ["critical", "minor"],
      "properties": {
        "critical": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["issue", "evidence_paths", "why_it_matters", "suggested_fix"],
            "properties": {
              "issue": { "type": "string" },
              "evidence_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "why_it_matters": { "type": "string" },
              "suggested_fix": { "type": "string" }
            }
          }
        },
        "minor": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["issue", "evidence_paths", "note"],
            "properties": {
              "issue": { "type": "string" },
              "evidence_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "commercial_contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "commercial_quote",
          "technical_evidence_paths",
          "problem",
          "minimal_fix"
        ],
        "properties": {
          "commercial_quote": { "type": "string" },
          "technical_evidence_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "problem": { "type": "string" },
          "minimal_fix": { "type": "string" }
        }
      }
    },
    "commercial_minimal_edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["location_hint", "before", "after", "reason"],
        "properties": {
          "location_hint": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "notes_for_engineers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
